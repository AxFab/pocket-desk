  "tips": [
    {
      "t": "Compact regularly",
      "d": "Each update or delete leaves a dead record. db.compact() rewrites the file in one pass and recovers space."
    },
    {
      "t": "Index before sorting",
      "d": "Sorting is always eager. First, reduce the candidate set with an indexed query before sorting large collections."
    },
    {
      "t": "A file, a database",
      "d": "A pocket-db instance is a single . pdb file—copy it to save, move it to migrate. No server, no daemon."
    },
    {
      "t": "The _ids are immutable",
      "d": "The _id field (24 hex characters) cannot be modified by any update operator. Provide your own when you insert if necessary."
    },
    {
      "t": "The planner chooses the index",
      "d": "For each query, pocket-db automatically selects the most selective index available. NumberIndex also handles range scans."
    }
